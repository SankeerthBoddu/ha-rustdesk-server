{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s+"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/{{package}}",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "matchStrings": ["ARG RUSTDESK_SERVER_VERSION=(?<currentValue>.+?)\\s+"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rustdesk/rustdesk-server",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "matchDatasources": ["docker"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "Home Assistant base image"
    },
    {
      "matchDatasources": ["repology"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "{{packageName}}",
      "groupName": "internal packages"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["rustdesk/rustdesk-server"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "RustDesk Server",
      "prBodyNotes": [
        "After a RustDesk version bump, update both pinned RUSTDESK_SERVER_SHA256_* values from the upstream GitHub release asset digests. CI intentionally fails until those digests match."
      ]
    }
  ]
}
